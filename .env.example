# Vector DB
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Relational DB
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=swiss_legal_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# LLM provider (choose one)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# or
OPENAI_API_KEY=

# LLM model id used by the configured provider. Default is the cheapest current
# Anthropic model — good for iterating on the Phase 3 Streamlit test UI without
# running up costs.
LLM_MODEL=claude-haiku-4-5-20251001

# Embedding model
# Default is a standard multilingual model (no custom remote code required).
# jinaai/jina-embeddings-v3 can be tried instead, but as of this writing its pinned
# trust_remote_code revision is incompatible with recent `transformers` releases on
# at least some platforms (see README/audit notes).
# Other good multilingual options: intfloat/multilingual-e5-large, intfloat/multilingual-e5-base
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu   # or cuda, if you have an NVIDIA GPU — see pyproject.toml's
                       # [tool.uv.sources] for how the CUDA-enabled torch build is pinned
                       # (plain `pip install torch` on Windows/macOS is CPU-only)
EMBEDDING_BATCH_SIZE=16
# On GPU, 16 already gives a large speedup (~34x measured on an RTX 3060 Ti) — counter-
# intuitively, raising this can make things *slower* or stall: sentence-transformers pads
# every item in a batch to that batch's longest sequence, so one long chunk (this
# pipeline allows up to ~1500 tokens) blows up memory/time for the whole batch at a
# bigger batch size. Test carefully before raising it.

# Ingestion scope — comma-separated SR/RS systematic-number prefixes.
# Default covers tax law (640/642), civil code (210), code of obligations (220),
# criminal code (311.0), criminal procedure (312.0), civil procedure (272), and the
# federal constitution (101). Add more prefixes to widen coverage further.
FEDLEX_SYSTEMATIC_PREFIXES=640,642,210,220,311.0,312.0,272,101
SNB_TEST_CUBES=rendoblim,snbmonagg
CURIA_VISTA_DATE_FROM=2025-01-01
